DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
PORT=4000
ADMIN_ORIGIN="http://localhost:3000"
NODE_ENV="development"
TRUST_PROXY=0
PUBLIC_BASE_URL="http://localhost:4000"
# Demo di hosting: izinkan tombol "Saya Sudah Bayar" walau NODE_ENV=production.
ALLOW_SIMULATE_PAY="false"
# Alamat lain yang boleh memanggil API, dipisah koma (mis. web Flutter: https://sumbersira.vercel.app).
EXTRA_ORIGINS=""
PAYMENT_MODE="simulation"
MIDTRANS_ENV="sandbox"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
