# ============================================================
# SumberSira Backend — contoh konfigurasi environment
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit .env (berisi password database dan kunci rahasia).
# ============================================================

# Connection string PostgreSQL/Neon. WAJIB.
# Pakai alamat direct (tanpa "-pooler") untuk menjalankan migrasi.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Port HTTP server. Bawaan: 4000.
PORT=4000

# Origin yang diizinkan CORS (web admin dan/atau web pengunjung).
# Boleh lebih dari satu, dipisah koma. Boleh ada spasi setelah koma.
# Garis miring di akhir otomatis dibuang.
# Contoh: "https://admin.sumbersira.id,https://app.sumbersira.id"
ADMIN_ORIGIN="http://localhost:3000"

# development | test | production. Bawaan: development.
# Produksi: CORS localhost dimatikan, cookie Secure, simulate-pay mati.
NODE_ENV="development"

# Jumlah reverse proxy di depan server (Vercel/Railway/Render/NGINX = 1).
# Dipakai agar rate limit membaca IP asli klien. Bawaan: 0.
TRUST_PROXY=0

# Tingkat detail log terstruktur (JSON):
# fatal | error | warn | info | debug | trace | silent. Bawaan: info.
LOG_LEVEL="info"

# URL publik backend ini (tanpa garis miring di akhir).
# Dipakai untuk DUA hal:
#   1. URL foto galeri/AI Photo saat STORAGE_DRIVER=local,
#   2. URL webhook Midtrans (header X-Override-Notification).
# WAJIB diisi bila NODE_ENV=production dan STORAGE_DRIVER=local.
# Saat development boleh kosong (memakai http://localhost:PORT).
PUBLIC_BASE_URL="http://localhost:4000"

# simulation | midtrans. Bawaan: simulation.
# simulation: QRIS palsu + endpoint uji POST /payments/:id/simulate-pay.
# midtrans  : QRIS sungguhan lewat Core API Midtrans + webhook.
PAYMENT_MODE="simulation"

# sandbox | production. Bawaan: sandbox (memakai api.sandbox.midtrans.com).
MIDTRANS_ENV="sandbox"

# Kunci server Midtrans. WAJIB diisi bila PAYMENT_MODE=midtrans.
# Jangan pernah menaruh kunci asli di README/dokumen/commit.
MIDTRANS_SERVER_KEY=""

# Kunci client Midtrans, dipakai web admin (Snap/QR). Boleh kosong bila
# web admin tidak memakainya.
MIDTRANS_CLIENT_KEY=""

# local | vercel-blob. Bawaan: local (folder uploads/, cocok development).
STORAGE_DRIVER="local"

# Token Vercel Blob. WAJIB diisi bila STORAGE_DRIVER=vercel-blob.
BLOB_READ_WRITE_TOKEN=""
