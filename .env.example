DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
PORT=4000
ADMIN_ORIGIN="http://localhost:3000"
NODE_ENV="development"
TRUST_PROXY=0
PUBLIC_BASE_URL="http://localhost:4000"
# Demo di hosting: izinkan tombol "Saya Sudah Bayar" walau NODE_ENV=production.
ALLOW_SIMULATE_PAY="false"
# Alamat lain yang boleh memanggil API, dipisah koma (mis. web Flutter: https://sumbersira.vercel.app).
EXTRA_ORIGINS=""
PAYMENT_MODE="simulation"
MIDTRANS_ENV="sandbox"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# --- Fitur AI (hanya dua: chatbot Tanya Sira dan perbaikan foto) ---
# Kunci GRATIS dari aistudio.google.com (Get API key). Jangan hubungkan akun penagihan ke proyek kuncinya supaya tetap gratis.
# Kosong = AI mati: chatbot menjawab dari FAQ, foto diperbaiki dengan pengolahan gambar otomatis.
AI_API_KEY=""
# Alamat API yang kompatibel dengan OpenAI. Bawaan Gemini; penyedia gratis lain cukup ganti alamat, kunci, dan model.
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# Model gratis dengan kuota paling longgar. Pilihan lain yang gratis: gemini-3.6-flash, gemini-3.8-flash (kuota lebih sedikit).
CHAT_MODEL="gemini-3.5-flash-lite"
PHOTO_AI_MODEL="gemini-3.5-flash-lite"
# Opsional: tingkat berpikir model (minimal, low, medium, high). Biarkan kosong bila tidak yakin.
AI_REASONING_EFFORT=""
# Batas panggilan AI per hari (WIB) supaya kuota gratis tidak habis oleh sedikit pengguna. Lewat batas, beralih ke cadangan tanpa AI. 0 = AI mati.
CHAT_AI_DAILY_LIMIT=150
PHOTO_AI_DAILY_LIMIT=100
