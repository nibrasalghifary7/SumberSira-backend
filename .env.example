DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
PORT=4000
ADMIN_ORIGIN="http://localhost:3000"
NODE_ENV="development"
TRUST_PROXY=0
PUBLIC_BASE_URL="http://localhost:4000"
# Demo di hosting: izinkan tombol "Saya Sudah Bayar" walau NODE_ENV=production.
ALLOW_SIMULATE_PAY="false"
# Alamat lain yang boleh memanggil API, dipisah koma (mis. web Flutter: https://sumbersira.vercel.app).
EXTRA_ORIGINS=""
PAYMENT_MODE="simulation"
MIDTRANS_ENV="sandbox"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# --- Fitur AI (hanya dua: chatbot Tanya Sira dan perbaikan foto) ---
# Kunci dari console.anthropic.com. Kosong = AI mati: chatbot menjawab dari FAQ, foto diperbaiki dengan pengolahan gambar otomatis.
ANTHROPIC_API_KEY=""
# Model Claude. Bawaan claude-opus-5-5; model lebih murah/cepat: claude-haiku-5-5 atau claude-sonnet-5-5.
CHAT_MODEL="claude-opus-5-5"
PHOTO_AI_MODEL="claude-opus-5-5"
# Batas panggilan AI per hari (WIB) sebagai pengaman biaya. Lewat batas, beralih ke cadangan tanpa AI. 0 = AI mati.
CHAT_AI_DAILY_LIMIT=300
PHOTO_AI_DAILY_LIMIT=200
