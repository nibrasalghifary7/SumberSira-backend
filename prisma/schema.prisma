generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  petugas
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
}

model Ride {
  id       String  @id          // slug, mis. "ban-kecil"
  name     String
  category String               // "Sewa Alat" atau "Wahana"
  price    Int
  unit     String  @default("")
  icon     String
  active   Boolean @default(true)
}

model TimeSlot {
  id        String  @id         // mis. "08-10"
  label     String
  timeRange String               // mis. "08.00 - 10.00"
  busy      Boolean @default(false)
}

// ---------- Tiket masuk dan Live Crowd ----------
// Live Crowd = jumlah orang dari tiket berstatus "inside" pada hari itu (WIB), dibagi kapasitas.
// Check-in menaikkan angka, check-out menurunkannya; tiket hari lain tidak dihitung.

enum TicketStatus {
  waiting // Belum masuk
  inside  // Di dalam
  out     // Keluar
}

enum Parking {
  none
  motor
  mobil
  bus
}

enum PayMethod {
  qris
  cash
}

model Ticket {
  id         String       @id @default(cuid())
  no         Int          @unique @default(autoincrement()) // nomor urut; kode tiket = TK-(1000 + no)
  name       String
  whatsapp   String // sudah dirapikan jadi 08xxxxxxxxxx
  adults     Int
  kids       Int          @default(0)
  parking    Parking      @default(none)
  payment    PayMethod    @default(qris)
  total      Int
  arrival    String       @default("") // perkiraan jam datang, mis. "08.00 - 10.00"
  source     String       @default("app") // "app" = dibeli lewat aplikasi pengunjung, "loket" = dijual petugas di loket
  visitDate  String // tanggal berlaku (WIB), mis. "2026-11-11"
  status     TicketStatus @default(waiting)
  boughtAt   DateTime     @default(now())
  checkInAt  DateTime?
  checkOutAt DateTime?

  @@index([visitDate])
  @@index([whatsapp])
}

// ---------- Chatbot Tanya Sira dan FAQ ----------

enum ChatStatus {
  pending  // menunggu dijawab pengelola
  answered // sudah dijawab pengelola
}

// Jawaban cepat tanpa AI yang dibuat pengelola.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  keywords  String   @default("") // kata kunci tambahan, dipisah koma
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pertanyaan pengunjung yang dikirim ke pengelola (jawaban lambat, ditulis manusia).
model ChatQuestion {
  id         String     @id @default(cuid())
  deviceId   String // ID acak per perangkat, supaya balasan bisa dikirim ke perangkat yang bertanya
  question   String
  status     ChatStatus @default(pending)
  answer     String?
  askedAt    DateTime   @default(now())
  answeredAt DateTime?

  @@index([status, askedAt])
  @@index([deviceId])
}

// Catatan tiap pertanyaan yang dijawab otomatis, untuk menghitung persentase jawaban otomatis.
model ChatLog {
  id        String   @id @default(cuid())
  source    String // faq, ai, kb, atau unknown
  question  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
